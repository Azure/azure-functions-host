// Query-local helper. Paste before a query; this file does not create a database function.
// Apply a source time filter before invoking. Existing physical columns are preserved.
let NormalizeWorkerProxyLogs = (T:(*))
{
    T
    | extend _wpSummary = tostring(column_ifexists("Summary", ""))
    | extend _wpRest = replace_regex(_wpSummary, @"^(WorkerId=[^;]*; )?(ProxySessionId=[^;]*; )?", ""),
        ProxyWorkerId = extract(@"^WorkerId=([^;]*); ", 1, _wpSummary),
        _wpSession = extract(@"^(?:WorkerId=[^;]*; )?ProxySessionId=([^;]*); ", 1, _wpSummary)
    | extend MetadataVersion = extract(@"^WP([0-9]+)\[", 1, _wpRest),
        _wpMetadata = extract(@"^WP1\[([^\]]*)\]; ", 1, _wpRest),
        ProxySessionId = tolong(_wpSession)
    | extend _wpKeys = extract_all(@"(?:^|;)([a-z]+)=", _wpMetadata)
    | parse-kv _wpMetadata as (
        p:string, a:string, g:string, r:string, sr:string, s:string, wr:string, rm:string, dr:string,
        q:string, i:string, f:string, op:string, ph:string, o:string, rc:string, sd:string,
        sc:string, rpc:string, ye:string, ms:string, cs:string, at:string, rs:string,
        n:string, uf:string, pm:string, b:string, omit:string)
        with (pair_delimiter=';', kv_delimiter='=')
    | extend ProxyPodName = p, ProxyAppName = a, FunctionGroupName = g,
        StateRevision = tolong(r), IdentitySnapshotRevision = tolong(sr), AssignmentState = s,
        WorkerReady = tobool(wr), RemovalRequested = tobool(rm), WorkerDraining = tobool(dr),
        RequestId = q, InvocationId = i, FunctionId = f,
        Operation = op, Phase = ph, Outcome = o, ReasonCode = rc, Side = sd,
        StatusCode = toint(sc), RpcStatus = rpc, ForwarderError = ye, ElapsedMs = toreal(ms),
        CancellationSource = cs, Attempts = toint(at), ResponseStarted = tobool(rs),
        FunctionCount = toint(n), UnsuccessfulCount = toint(uf), PendingMessages = toint(pm),
        ProxyBuildVersion = b, MetadataOmitted = omit == "1"
    | extend MetadataParseStatus = case(
        isnotempty(_wpSession) and isnull(ProxySessionId), "InvalidLegacySession",
        not(_wpRest startswith "WP"), "Legacy",
        isnotempty(MetadataVersion) and MetadataVersion != "1", "UnsupportedVersion",
        isempty(_wpMetadata) or not(_wpMetadata matches regex
            @"^((p|a|g|r|sr|s|wr|rm|dr|q|i|f|op|ph|o|rc|sd|sc|rpc|ye|ms|cs|at|rs|n|uf|pm|b|omit)=[A-Za-z0-9._:+-]{1,128};)+$"),
            "MalformedEnvelope",
        array_length(_wpKeys) != array_length(set_union(_wpKeys, dynamic([]))), "DuplicateKey",
        (isnotempty(r) and isnull(StateRevision)) or (isnotempty(sr) and isnull(IdentitySnapshotRevision))
            or (isnotempty(sc) and isnull(StatusCode)) or (isnotempty(ms) and isnull(ElapsedMs))
            or (isnotempty(at) and isnull(Attempts)) or (isnotempty(n) and isnull(FunctionCount))
            or (isnotempty(uf) and isnull(UnsuccessfulCount)) or (isnotempty(pm) and isnull(PendingMessages))
            or (isnotempty(wr) and wr !in ("true", "false"))
            or (isnotempty(rm) and rm !in ("true", "false"))
            or (isnotempty(dr) and dr !in ("true", "false"))
            or (isnotempty(rs) and rs !in ("true", "false"))
            or (isnotempty(omit) and omit != "1"), "InvalidTypedValue",
        MetadataOmitted, "FieldsOmitted",
        "Parsed")
    | extend MissingMetadataFields = set_difference(pack_array(
        iff(isempty(ProxyPodName), "PodName", ""),
        iff(isnull(StateRevision), "StateRevision", ""),
        iff(isempty(ProxyWorkerId), "WorkerId", ""),
        iff(isnull(ProxySessionId), "ProxySessionId", ""),
        iff(isempty(ProxyAppName), "AppName", ""),
        iff(isempty(FunctionGroupName), "FunctionGroupName", "")), dynamic([""])),
        MissingAssignedIdentity = AssignmentState in ("Assigned", "Ready", "Failed", "Terminated")
            and (isempty(ProxyAppName) or isempty(FunctionGroupName)),
        HumanSummary = iff(MetadataVersion == "1", replace_regex(_wpRest, @"^WP1\[[^\]]*\]; ", ""), _wpRest)
    | project-away _wp*, p, a, g, r, sr, s, wr, rm, dr, q, i, f, op, ph, o, rc, sd, sc, rpc, ye, ms, cs, at, rs, n, uf, pm, b, omit
};
