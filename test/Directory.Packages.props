<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />

  <PropertyGroup>
    <BlobExtensionVersion Condition="'$(BlobExtensionVersion)' == ''">5.3.10</BlobExtensionVersion>
  </PropertyGroup>

  <!-- Testing Packages -->
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.1.0" />
    <PackageVersion Include="AwesomeAssertions.Analyzers" Version="9.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="8.1.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.4.1" />
    <PackageVersion Include="Moq" Version="4.18.4" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="2.1.0.227" />
    <PackageVersion Include="xunit" Version="2.4.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Supporting Packages -->
  <ItemGroup>
    <PackageVersion Update="Azure.Core" Version="1.53.0" Condition="'$(MSBuildProjectName)' == 'Functions.Rpc.Client.Tests'" />
    <PackageVersion Update="Azure.Storage.Blobs" Version="12.26.0" Condition="'$(MSBuildProjectName)' == 'Functions.Rpc.Client.Tests'" />
    <PackageVersion Update="Microsoft.Extensions.Azure" Version="1.14.0" Condition="'$(MSBuildProjectName)' == 'Functions.Rpc.Client.Tests'" />
    <PackageVersion Include="Microsoft.AspNet.WebApi.Core" Version="5.2.6" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.54.0" />
    <PackageVersion Include="Microsoft.Azure.WebJobs.Extensions.CosmosDB" Version="4.11.0" />
    <PackageVersion Include="Microsoft.Azure.WebJobs.Extensions.EventHubs" Version="6.5.5" />
    <PackageVersion Include="Microsoft.Azure.WebJobs.Extensions.Storage" Version="5.3.0" />
    <PackageVersion Include="Microsoft.Azure.WebJobs.Extensions.Storage.Blobs" Version="$(BlobExtensionVersion)" />
    <PackageVersion Include="Microsoft.Azure.WebJobs.Extensions.Tables" Version="1.4.0" />
  </ItemGroup>

</Project>
