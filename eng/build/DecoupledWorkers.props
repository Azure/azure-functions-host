<Project>
  <!-- Organize workers into versioned folder structure -->
  <Target Name="OrganizeWorkersByVersion" AfterTargets="ResolvePackageAssets" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <!-- Java Worker -->
      <None Condition="'%(None.NuGetPackageId)' == 'Microsoft.Azure.Functions.JavaWorker'">
        <TargetPath>DecoupledWorkers/java/%(None.NuGetPackageVersion)/%(None.RecursiveDir)%(None.Filename)%(None.Extension)</TargetPath>
      </None>
      
      <!-- Node Worker -->
      <None Condition="'%(None.NuGetPackageId)' == 'Microsoft.Azure.Functions.NodeJsWorker' And '%(Filename)%(Extension)' != 'nodejsWorker.js' And '%(Filename)%(Extension)' != 'worker-bundle.js'">
        <TargetPath>DecoupledWorkers/node/%(None.NuGetPackageVersion)/%(None.RecursiveDir)%(None.Filename)%(None.Extension)</TargetPath>
      </None>
      
      <!-- Move nodejsWorker.js and worker-bundle.js to dist/src subfolder -->
      <None Condition="'%(None.NuGetPackageId)' == 'Microsoft.Azure.Functions.NodeJsWorker' And ('%(Filename)%(Extension)' == 'nodejsWorker.js' Or '%(Filename)%(Extension)' == 'worker-bundle.js')">
        <TargetPath>DecoupledWorkers/node/%(None.NuGetPackageVersion)/dist/src/%(None.Filename)%(None.Extension)</TargetPath>
      </None>
            
      <!-- .NET Isolated Worker -->
      <None Condition="'%(None.NuGetPackageId)' == 'Microsoft.Azure.Functions.DotNetIsolatedNativeHost'">
        <TargetPath>DecoupledWorkers/dotnet-isolated/%(None.NuGetPackageVersion)/%(None.RecursiveDir)%(None.Filename)%(None.Extension)</TargetPath>
      </None>      
    </ItemGroup>
  </Target>

</Project>
