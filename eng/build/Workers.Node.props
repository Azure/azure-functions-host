<Project>

  <PropertyGroup>
    <NodeVersion>3.12.0</NodeVersion>
    <NodeVersion Condition="'$(WorkerName)' == 'Microsoft.Azure.Functions.NodeJsWorker' AND '$(WorkerVersion)' != ''">$(WorkerVersion)</NodeVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.NodeJsWorker" VersionOverride="$(NodeVersion)" />
  </ItemGroup>


  <Target Name="PrintNodeVersion" BeforeTargets="Restore;Build">
    <Message Importance="High" Text="NodeVersion=$(NodeVersion)" />
  </Target>

</Project>
