<Project>

  <PropertyGroup>
    <JavaVersion>2.19.2</JavaVersion>
    <JavaVersion Condition="'$(WorkerName)' == 'java' AND '$(WorkerVersion)' != ''">$(WorkerVersion)</JavaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.JavaWorker" VersionOverride="$(JavaVersion)" />
  </ItemGroup>

  <Target Name="PrintJavaVersion" BeforeTargets="Restore;Build">
    <Message Importance="High" Text="JavaVersion=$(JavaVersion)" />
  </Target>
  
</Project>
