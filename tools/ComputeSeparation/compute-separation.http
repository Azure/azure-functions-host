@platform=http://localhost:7060
@host=http://127.0.0.1:7071
@workerProxy=http://localhost:7081

# Single-worker scenario: assign -> link -> invoke.
# In Visual Studio, select the AppHost profile `project-placeholder-manual` and press F5.
# Or run from the repository root:
# dotnet run --project tools\ComputeSeparation\AppHost\ComputeSeparation.AppHost.csproj --launch-profile project-placeholder-manual
#
# For the later-linked second-worker scenario, use compute-separation-multi-worker.http instead.
# Stop any previous AppHost before starting: these manual profiles share fixed ports.
# /simulate routes belong to FakePlatform; it calls the real Host and WorkerProxy contracts.

# 1. Assign the worker pod
# Expect 201 (204 if repeated). Retry 503 WorkerNotReady after the worker connects.
# @name assignWorker
POST {{platform}}/simulate/worker/assign

### Optional: inspect worker state
# Expect ReadyForRequest after assignment.
GET {{workerProxy}}/admin/worker/state

### 2. Assign the placeholder Host to the app
# Expect 202 (409 if repeated). Specialization applies configuration without waiting for a worker link.
# @name assignHost
POST {{platform}}/simulate/host/assign

### 3. Link the worker to the Host
# Expect 201 (200 for a matching retry).
# @name linkWorker
POST {{platform}}/simulate/worker/link

### Optional: inspect the last published HTTP capacity
# Expect { "createdTime": "<ISO8601 UTC timestamp>", "httpCapacity": 16, "workerCount": 1 } once ScriptHost and the HTTP worker are ready.
# Retries reuse the captured createdTime. Distinct snapshots can have equal or earlier timestamps.
# FakePlatform ignores strictly older timestamps with 200 and accepts ties in arrival order, not causal order.
# Clock rollback can leave a legitimate update ignored; this is not restart-safe ordering.
# Capacity is 0 before readiness; 204 means the Host has not published yet.
# Each ready HTTP worker contributes a fixed 16; non-HTTP, unknown-group, and not-ready workers contribute 0.
# WorkerProxy-supplied concurrency is deferred. No override, worker-side throttle, or slot leasing is introduced.
GET {{platform}}/simulate/host/state

### 4. Invoke through Host -> WorkerProxy -> worker
# Expect 200 and X-Compute-Worker-Id identifying the worker.
# @name invokeWorker
GET {{host}}/api/hello
