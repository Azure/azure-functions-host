<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <!-- Keep package versions explicit so the app also builds outside the Host repository. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <WarningsAsErrors>$(WarningsAsErrors);NU1603</WarningsAsErrors>
    <FunctionsWorkerPackageVersion Condition="'$(FunctionsWorkerPackageVersion)' == ''">2.53.0-preview.1</FunctionsWorkerPackageVersion>
    <FunctionsWorkerSdkPackageVersion Condition="'$(FunctionsWorkerSdkPackageVersion)' == ''">2.1.0</FunctionsWorkerSdkPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="$(FunctionsWorkerPackageVersion)" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" Version="5.5.3" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="$(FunctionsWorkerSdkPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- VS selects the Core Tools debug launcher through this capability, independently of the dotnet run targets. -->
  <ItemGroup>
    <ProjectCapability Remove="AzureFunctions" />
  </ItemGroup>

  <!-- This worker-only fixture uses the .NET SDK's direct managed launch, not the Worker SDK's Core Tools host launcher. -->
  <Target Name="_FunctionsComputeRunArguments" />
  <Target Name="_FunctionsCheckForCoreTools" />
  <Target Name="_FunctionsComputeRunArgumentsWhenFuncNotExists" />

</Project>
